<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/demo_surface"
        android:elevation="0dp">
        <TextView android:id="@+id/pageTitle" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginHorizontal="80dp" android:gravity="center" android:text="@string/app_title" android:textSize="@dimen/demo_title" android:textColor="@color/demo_ink" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/backButton" style="@style/DemoButton" android:layout_width="60dp" android:layout_height="44dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="16dp" android:background="@android:color/transparent" android:textColor="@color/demo_accent" android:text="‹ 返回" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/themeButton" style="@style/DemoButton" android:layout_width="60dp" android:layout_height="44dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="16dp" android:background="@android:color/transparent" android:textColor="@color/demo_accent" android:text="主题" />
    </FrameLayout>
